					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string"
			}
		},
		"annotations": []
	}
}